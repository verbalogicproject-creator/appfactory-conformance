<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime-requestable from API 33. MainActivity states an explicit behaviour
         on denial: the app degrades and says so. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- android:name MUST point at the @HiltAndroidApp class. The annotation on a
         class the system never instantiates produces the identical launch crash as
         having no annotation at all, and looks correct in the source. -->
    <application
        android:name=".ConformanceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conformance"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Conformance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
